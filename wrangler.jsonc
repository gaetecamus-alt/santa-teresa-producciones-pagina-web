{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "santa-teresa-producciones-pagina-web",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],

  // Serve static files (index.html, img/, etc.) from the root directory.
  // - auto-trailing-slash: /matrimonios.html se sirve en /matrimonios
  // - 404-page: rutas inexistentes devuelven 404.html con status 404
  // - run_worker_first: el Worker ve todas las requests (redirect www → apex)
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Códigos de referencia de WhatsApp (Ref: XXXX) con su origen (gclid, utm…), TTL 180 días.
  // Se escriben en POST /api/lead-ref y se exportan en GET /api/lead-refs.csv (requiere EXPORT_TOKEN).
  "kv_namespaces": [
    {
      "binding": "LEAD_REFS",
      "id": "01110aa0e38340ec9fededce8356a63b"
    }
  ],

  // Email routing binding — allows sending outbound emails
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "destination_address": "contacto@steresa.cl"
    }
  ],

  // Observability — logs enabled, traces disabled
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
